{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "build:android-spike": "ng build --configuration android-spike",
    "sync:android-spike": "npm run build:android-spike && cap sync android",
    "apk:android-spike": "node ../android-companion/build.cjs --project android :app:assembleDebug",
    "build:android-lan": "ng build --configuration android-lan",
    "sync:android-lan": "npm run build:android-lan && node scripts/sync-android-production.cjs dist/android-lan/browser",
    "apk:android-lan": "node ../android-companion/build.cjs --project android :app:assembleDebug",
    "build:android-production": "ng build --configuration android-production",
    "sync:android-production": "npm run build:android-production && node scripts/sync-android-production.cjs",
    "apk:android-production": "npm run sync:android-production && node ../android-companion/build.cjs --project android :app:assembleDebug",
    "prepare:android-jdk": "node scripts/prepare-android-jdk.cjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.25",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/service-worker": "^19.2.0",
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/share": "7.0.4",
    "@capgo/capacitor-social-login": "7.19.1",
    "echarts": "^6.1.0",
    "finance-tracker-backend": "file:../backend",
    "ngx-echarts": "^19.0.0",
    "personal-finance-tracker": "file:..",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@capacitor/cli": "7.4.3",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.5.4",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.7.2"
  }
}
