  /// User-chosen target asset allocation for the Rebalancing Score (Financial Health). Null = use the 60/30/10 default.
  targetEquityPercent             Int?
  targetDebtPercent               Int?
  targetGoldPercent               Int?
  /// Retirement Readiness / FI Ratio inputs (Financial Health). Null expense = fall back to current monthly expenses; null rate = 4%.
  retirementMonthlyExpense        Decimal? @db.Decimal(14, 2)
  retirementWithdrawalRatePercent Decimal? @db.Decimal(4, 2)
  /// ISO 3166-1 alpha-2 country code. "IN" keeps financialYearStartMonth fixed at 4 (India's legally-mandated Apr-Mar year, matches the Tax module) — only non-"IN" users can customize it.
  country                         String   @default("IN")
  /// 1-12 (April = 4). Used by Analytics' Year-over-Year report to bucket dates into a fiscal year instead of a plain calendar year.
  financialYearStartMonth         Int      @default(4)
  /// User-level opt-out of the AI Chat widget (ai-chat module). Does not affect ai-insights (rule-based, no LLM calls, always on).
  aiChatEnabled                   Boolean  @default(true)
  updatedAt                       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

