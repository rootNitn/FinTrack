/// A single buy/sell lot for the multi-transaction Capital Gains Calculator (Feature 7). Tax rates
/// and indexation are resolved at calculation time from `TaxCapitalGainRule` / `CostInflationIndex`
/// (DB-driven, not hardcoded) and the computed results are snapshotted here.
model CapitalGainsTransaction {
  id                String               @id @default(uuid())
  userId            String
  financialYearCode String
  assetType         CapitalGainAssetType
  purchaseDate      DateTime
  purchasePrice     Decimal              @db.Decimal(14, 2)
  saleDate          DateTime
  salePrice         Decimal              @db.Decimal(14, 2)
  quantity          Decimal              @db.Decimal(14, 4)
  brokerage         Decimal              @default(0) @db.Decimal(14, 2)
  stampDuty         Decimal              @default(0) @db.Decimal(14, 2)
  transferCharges   Decimal              @default(0) @db.Decimal(14, 2)
  holdingPeriodDays Int
  termType          CapitalGainTermType
  indexedCost       Decimal?             @db.Decimal(14, 2)
  gainAmount        Decimal              @db.Decimal(14, 2)
  taxAmount         Decimal              @db.Decimal(14, 2)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, financialYearCode])
  @@map("capital_gains_transactions")
}

/// Snapshot of an Advance Tax Calculator run (Feature 6) — installment schedule + 234B/234C
/// interest, stored as JSON so historical runs remain valid if computation logic evolves.
model AdvanceTaxCalculation {
  id                String   @id @default(uuid())
  userId            String
  financialYearCode String
  inputs            Json
  result            Json
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, financialYearCode])
  @@map("advance_tax_calculations")
}

/// Snapshot of a Tax Saving Planner run (Feature 5) — the generated suggestion cards, stored as
/// JSON so historical plans remain viewable even if suggestion logic evolves.
model TaxSavingPlan {
  id                String   @id @default(uuid())
  userId            String
  financialYearCode String
  inputs            Json
  suggestions       Json
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, financialYearCode])
  @@map("tax_saving_plans")
}

/// Admin-managed Cost Inflation Index values, used to compute indexed cost for LTCG on Property/
/// Gold/Debt Mutual Funds in the Capital Gains Calculator.
model CostInflationIndex {
  id       String @id @default(uuid())
  year     String @unique // e.g. "2025-26"
  ciiValue Int

  @@map("cost_inflation_indices")
}

/// Admin-managed capital gains tax rate/exemption/indexation rule per asset type + holding term —
/// replaces what were previously hardcoded constants in calculation-helpers.util.ts.
model TaxCapitalGainRule {
  id                String               @id @default(uuid())
  assetType         CapitalGainAssetType
  termType          CapitalGainTermType
  ratePercent       Decimal              @db.Decimal(5, 2)
  exemptionLimit    Decimal?             @db.Decimal(14, 2)
  indexationAllowed Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([assetType, termType])
  @@map("tax_capital_gain_rules")
}

/// Admin-managed validation rule driving the "Validate extracted values" requirement for document
/// imports (e.g. Gross Salary should equal the sum of its components, within a tolerance).
model TaxValidationRule {
  id           String          @id @default(uuid())
  documentType TaxDocumentType
  fieldName    String
  condition    String // e.g. "GROSS_EQUALS_SUM_OF_COMPONENTS", "NET_EQUALS_GROSS_MINUS_DEDUCTIONS"
  tolerance    Decimal         @default(1) @db.Decimal(14, 2)
  message      String
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([documentType])
  @@map("tax_validation_rules")
}

// ==================== HEALTH TRACKER MODULE ====================

enum VitalType {
  BLOOD_PRESSURE
  BLOOD_SUGAR
  HEART_RATE
}

enum WorkoutType {
  CARDIO
  STRENGTH
  YOGA
  SPORTS
  WALKING
  OTHER
}

enum MedicationLogStatus {
  TAKEN
  MISSED
  SKIPPED
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model HealthConnection {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  provider                String   @default("HEALTH_CONNECT")
  deviceName              String
  timezone                String
  enabledMetrics          String[]
  grantedMetrics          String[]
  primarySources          Json     @default("{}")
  backgroundReadGranted   Boolean  @default(false)
  backgroundReadAvailable Boolean  @default(false)
  consentedAt             DateTime @default(now())
  disconnectedAt          DateTime?
  generation              Int      @default(0)
  status                  String   @default("CONNECTED")
  lastSuccessfulSyncAt    DateTime?
  lastAttemptedSyncAt     DateTime?
  syncCompletedAt         DateTime?
  recordsSynced           Int      @default(0)
  errorCode               String?
  manualRequestedAt       DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  records HealthImportedRecord[]
  daily   HealthDailySummary[]
  batches HealthSyncRun[]

  @@index([userId])
  @@map("health_connections")
}

model HealthImportedRecord {
  id             String   @id @default(uuid())
  connectionId   String
  sourceRecordId String
  metricType     String
  source         String
  rawData        Json?
  value          Decimal  @db.Decimal(18, 4)
  unit           String
  startTime      DateTime
  endTime        DateTime
  modifiedAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  connection     HealthConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, metricType, sourceRecordId])
  @@index([connectionId, startTime])
  @@map("health_imported_records")
}

model HealthDailySummary {
  id               String   @id @default(uuid())
  connectionId     String
  date             String
  steps            Int?
  sleepMinutes     Decimal? @db.Decimal(8, 2)
  exerciseMinutes  Decimal? @db.Decimal(8, 2)
  weightKg         Decimal? @db.Decimal(8, 2)
  averageHeartRate Decimal? @db.Decimal(8, 2)
  aggregationVersion Int     @default(0)
  provenance       Json     @default("{}")
  nativeReference  Json?
  updatedAt        DateTime @updatedAt
  connection       HealthConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, date])
  @@map("health_daily_summaries")
}

model HealthSyncRun {
  id             String   @id @default(uuid())
  connectionId   String
  batchId        String
  syncStartedAt  DateTime
  completedAt    DateTime @default(now())
  recordsRead    Int
  recordsUploaded Int
  recordsSkipped Int
  recordsDeleted Int
  completed      Boolean
  connection     HealthConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, batchId])
  @@index([connectionId, syncStartedAt])
  @@map("health_sync_runs")
}

enum HealthGoalType {
  WEIGHT_TARGET
  STEPS_DAILY
  WATER_DAILY
  SLEEP_DAILY
  WORKOUT_WEEKLY
}

model BodyMetricLog {
  id             String   @id @default(uuid())
  userId         String
  weightKg       Decimal  @db.Decimal(6, 2)
  heightCm       Decimal? @db.Decimal(6, 2)
  /// Computed at write time from weightKg + the most recent known heightCm (kg / (heightM^2)).
  bmi            Decimal? @db.Decimal(5, 2)
  bodyFatPercent Decimal? @db.Decimal(5, 2)
  waistCm        Decimal? @db.Decimal(6, 2)
  notes          String?
  recordedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("body_metric_logs")
}

model VitalLog {
  id         String    @id @default(uuid())
  userId     String
  type       VitalType
  systolic   Int?
  diastolic  Int?
  value      Decimal?  @db.Decimal(8, 2)
  unit       String?
  context    String?
  notes      String?
  recordedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, recordedAt])
  @@map("vital_logs")
}

model WorkoutLog {
  id              String      @id @default(uuid())
  userId          String
  type            WorkoutType
  name            String?
  durationMinutes Int
  caloriesBurned  Int?
  distanceKm      Decimal?    @db.Decimal(6, 2)
  notes           String?
  date            DateTime    @default(now())
  createdAt       DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("workout_logs")
}

/// One row per user per calendar day — water/sleep/steps are typically logged as a daily total
/// rather than discrete events, unlike VitalLog/WorkoutLog.
model DailyWellnessLog {
  id            String   @id @default(uuid())
  userId        String
  date          DateTime
  waterIntakeMl Int?
  sleepHours    Decimal? @db.Decimal(4, 2)
  steps         Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_wellness_logs")
}

model Medication {
  id              String    @id @default(uuid())
  userId          String
  name            String
  dosage          String?
  /// Array of "HH:mm" strings, e.g. ["08:00", "20:00"], used by medication-reminder.job.ts.
  scheduleTimes   Json      @default("[]")
  startDate       DateTime
  endDate         DateTime?
  active          Boolean   @default(true)
  reminderEnabled Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs MedicationLog[]

  @@index([userId])
  @@map("medications")
}

model MedicationLog {
  id           String              @id @default(uuid())
  userId       String
  medicationId String
  status       MedicationLogStatus
  scheduledFor DateTime
  takenAt      DateTime?
  createdAt    DateTime            @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([medicationId, scheduledFor])
  @@map("medication_logs")
}

model DoctorAppointment {
  id              String            @id @default(uuid())
  userId          String
  doctorName      String
  specialty       String?
  appointmentDate DateTime
  location        String?
  notes           String?
  status          AppointmentStatus @default(SCHEDULED)
  reminderEnabled Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, appointmentDate])
  @@map("doctor_appointments")
}

model HealthGoal {
  id           String         @id @default(uuid())
  userId       String
  type         HealthGoalType
  targetValue  Decimal        @db.Decimal(10, 2)
  currentValue Decimal        @default(0) @db.Decimal(10, 2)
  deadline     DateTime?
  achievedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("health_goals")
}

/// A saved AI-generated wellness plan (see HealthAiImproveResponse), kept so a user can revisit
/// or print it without re-calling the AI. `content` stores the full validated JSON response.
model HealthWellnessPlan {
  id        String   @id @default(uuid())
  userId    String
  reportId  String?
  focusArea String?
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  report HealthReportDocument? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("health_wellness_plans")
}

enum HealthReportStatus {
  UPLOADED
  PARSED
  FAILED
  PASSWORD_REQUIRED
}

enum HealthResultFlag {
  LOW
  NORMAL
  HIGH
  UNKNOWN
}

/// Metadata for an uploaded lab/health report. The raw file itself is NOT persisted — only the
/// structured values extracted from it (see HealthReportResult) — to minimize storage of
/// sensitive medical documents at rest.
model HealthReportDocument {
  id            String             @id @default(uuid())
  userId        String
  fileName      String
  reportDate    DateTime
  testDate      DateTime?
  labName       String?
  patientName   String?
  patientAge    String?
  patientGender String?
  status        HealthReportStatus @default(UPLOADED)
  parseErrors   Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  results       HealthReportResult[]
  wellnessPlans HealthWellnessPlan[]

  @@index([userId, reportDate])
  @@map("health_report_documents")
}

/// A single extracted (or manually added/edited) lab test result row from a HealthReportDocument.
/// `flag` is recomputed from value vs referenceLow/High whenever either changes.
model HealthReportResult {
  id            String           @id @default(uuid())
  reportId      String
  userId        String
  testName      String
  value         Decimal          @db.Decimal(12, 4)
  unit          String?
  referenceLow  Decimal?         @db.Decimal(12, 4)
  referenceHigh Decimal?         @db.Decimal(12, 4)
  flag          HealthResultFlag @default(UNKNOWN)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  report HealthReportDocument @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, testName])
  @@index([reportId])
  @@map("health_report_results")
}
