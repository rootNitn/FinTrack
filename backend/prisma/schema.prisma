// ==================== INCOME TAX CALCULATOR MODULE ====================

enum TaxRegimeType {
  OLD
  NEW
}

/// Old-regime slab rates differ by age band; the new regime ignores age entirely (all rows
/// stored under GENERAL for the new regime).
enum TaxAgeCategory {
  GENERAL
  SENIOR
  SUPER_SENIOR
}

enum TaxEmploymentType {
  SALARIED
  SELF_EMPLOYED
  BUSINESS
  PENSIONER
}

enum TaxGender {
  MALE
  FEMALE
  OTHER
}

enum TaxResidentialStatus {
  RESIDENT
  NON_RESIDENT
  RNOR
}

// ==================== MODELS ====================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  googleId     String?   @unique
  name         String
  avatarUrl    String?
  dateOfBirth  DateTime?
  role         Role      @default(USER)
  isActive     Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // Two-factor auth (TOTP): secret is AES-256-GCM encrypted at rest (never sent to the client);
  // backup codes are stored as SHA-256 hashes (one-way, same convention as refresh tokens).
  totpSecret          String?
  totpEnabled         Boolean   @default(false)
  totpBackupCodes     String[]  @default([])
  planTier            PlanTier  @default(FREE)
  planExpiresAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  investments              Investment[]
  businessEntries          BusinessEntry[]
  businessProfiles         BusinessProfile[]
  businessMemberships      BusinessMember[]
  serviceTimesheets        BusinessServiceTimesheet[]
  transactions             Transaction[]
  expenses                 Expense[]
  incomes                  Income[]
  incomeSourceProfiles     IncomeSourceProfile[]
  goals                    Goal[]
  goalContributions        GoalContribution[]
  bankAccounts             BankAccount[]
  categories               Category[]
  notifications            Notification[]
  monthlySnapshots         MonthlySnapshot[]
  auditLogs                AuditLog[]
  budgets                  Budget[]
  setting                  Setting?
  fdPortfolios             FdPortfolio[]
  fdCalculations           FdCalculation[]
  fdFavoriteBanks          FdFavoriteBank[]
  creditCards              CreditCard[]
  creditCardStatements     CreditCardStatement[]
  creditCardPayments       CreditCardPayment[]
  importHistories          ImportHistory[]
  taxCalculations          TaxCalculation[]
  uploadedDocuments        UploadedDocument[]
  salarySlipRecords        SalarySlipRecord[]
  form16Records            Form16Record[]
  aisRecords               AisRecord[]
  form26ASRecords          Form26ASRecord[]
  capitalGainsTransactions CapitalGainsTransaction[]
  advanceTaxCalculations   AdvanceTaxCalculation[]
  taxSavingPlans           TaxSavingPlan[]
  familyMembers            FamilyMember[]
  supportTickets           SupportTicket[]
  bodyMetricLogs           BodyMetricLog[]
  vitalLogs                VitalLog[]
  workoutLogs              WorkoutLog[]
  dailyWellnessLogs        DailyWellnessLog[]
  medications              Medication[]
  medicationLogs           MedicationLog[]
  doctorAppointments       DoctorAppointment[]
  healthGoals              HealthGoal[]
  healthReportDocuments    HealthReportDocument[]
  healthReportResults      HealthReportResult[]
  healthWellnessPlans      HealthWellnessPlan[]
  healthConnections        HealthConnection[]
  liabilities              Liability[]
  insurancePolicies        InsurancePolicy[]
  subscriptions            Subscription[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A tag representing a family member (e.g. "Self", "Spouse", "Child") that expenses/investments
/// can optionally be linked to, so a single account can track spending/holdings per person without
/// needing separate logins. Scoped to the owning User — not a shared/multi-login household.
model FamilyMember {
  id        String   @id @default(uuid())
  userId    String
  name      String
  relation  String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses          Expense[]
  investments       Investment[]
  budgets           Budget[]
  fdPortfolios      FdPortfolio[]
  creditCards       CreditCard[]
  goals             Goal[]
  liabilities       Liability[]
  insurancePolicies InsurancePolicy[]
  transactions      Transaction[]
  incomes           Income[]

  @@index([userId])
  @@map("family_members")
}

enum LiabilityType {
  HOME_LOAN
  CAR_LOAN
  PERSONAL_LOAN
  EDUCATION_LOAN
  OTHER
}

/// A manually-tracked loan/liability (outside credit cards) used to compute Net Worth
/// (Total Assets − Total Liabilities) on the Financial Health page. `amount` is always the
/// CURRENT outstanding balance (what Net Worth sums) — the four fields below are optional and
/// only used to derive an EMI/amortization schedule when the user provides the loan's original
/// terms; Net Worth/Debt Health calculations never depend on them.
model Liability {
  id                  String        @id @default(uuid())
  userId              String
  name                String
  type                LiabilityType @default(OTHER)
  amount              Decimal       @db.Decimal(14, 2)
  interestRatePercent Decimal?      @db.Decimal(5, 2)
  principalAmount     Decimal?      @db.Decimal(14, 2)
  tenureMonths        Int?
  startDate           DateTime?
  emiAmount           Decimal?      @db.Decimal(14, 2)
  familyMemberId      String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMember FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyMemberId])
  @@map("liabilities")
}

enum InsuranceType {
  HEALTH
  LIFE
  OTHER
}

/// A manually-tracked insurance policy (health/life/other) used to compute the Insurance
/// Protection Score on the Financial Health page. Policy numbers are NOT stored — only the
/// coverage amounts needed to judge adequacy, to minimize retention of sensitive identifiers.
model InsurancePolicy {
  id             String        @id @default(uuid())
  userId         String
  type           InsuranceType
  provider       String?
  sumInsured     Decimal       @db.Decimal(14, 2)
  premiumAmount  Decimal?      @db.Decimal(14, 2)
  coversFamily   Boolean       @default(false)
  expiryDate     DateTime?
  renewalDate    DateTime?
  nominee        String?
  familyMemberId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMember FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([familyMemberId])
  @@map("insurance_policies")
}

model Investment {
  id                 String                  @id @default(uuid())
  userId             String
  name               String
  category           InvestmentCategory
  account            String?
  principalAmount    Decimal                 @db.Decimal(14, 2)
  currentValue       Decimal                 @db.Decimal(14, 2)
  targetValue        Decimal?                @db.Decimal(14, 2)
  purchaseDate       DateTime
  maturityDate       DateTime?
  sipAmount          Decimal?                @db.Decimal(14, 2)
  riskLevel          RiskLevel               @default(MODERATE)
  notes              String?
  status             InvestmentStatus        @default(ACTIVE)
  goalId             String?
  // Broker-statement import fields (nullable — only populated for imported rows; plain strings
  // so new providers/brokers/transaction types can be supported without further migrations).
  units              Decimal?                @db.Decimal(18, 4)
  purchaseNav        Decimal?                @db.Decimal(14, 4)
  currentNav         Decimal?                @db.Decimal(14, 4)
  broker             String?
  source             String?                 @default("MANUAL")
  transactionType    String?
  // Live price refresh fields — symbol is the exchange ticker (stocks) used to look up live
  // quotes; lastPriceRefreshAt records when currentNav/currentValue were last auto-updated.
  symbol             String?
  lastPriceRefreshAt DateTime?
  // Mutual Fund scheme metadata cache — resolved once (via name matching against api.mfapi.in)
  // during price refresh and reused thereafter, powering the Mutual Funds dashboard's per-fund
  // grouping and category-benchmark performance rating without re-matching on every read.
  mfSchemeCode       Int?
  mfSchemeCategory   String?
  // Multi-currency support — `currency` is the ISO 4217 code the holding was originally
  // purchased in; `exchangeRate` is the rate (1 unit of `currency` = N units of the account's
  // base/display currency) captured at entry time. `principalAmount`/`currentValue` above always
  // stay denominated in the account's base currency so existing sums/aggregates/reports are
  // unaffected — these two fields are purely informational, letting the UI show back the
  // original foreign-currency amount (principalAmount / exchangeRate) for transparency.
  currency           String                  @default("INR")
  exchangeRate       Decimal                 @default(1) @db.Decimal(18, 6)
  familyMemberId     String?
  // Recurring investment (e.g. a monthly/weekly SIP-style auto-buy) — mirrors the Income/Expense
  // recurrence pattern. When isRecurring is true, a background job creates a new Investment row
  // (with parentInvestmentId pointing back here) each time nextRecurrenceDate arrives.
  isRecurring        Boolean                 @default(false)
  recurrenceInterval RecurrenceInterval?
  recurrenceEndDate  DateTime?
  nextRecurrenceDate DateTime?
  parentInvestmentId String?
  fdTenureValue      Decimal?                @db.Decimal(8, 2)
  fdTenureUnit       InvestmentFdTenureUnit?
  fdInterestRate     Decimal?                @db.Decimal(5, 2)
  fdCompounding      FdCompoundingFrequency?
  fdDepositType      FdDepositType?
  fdMaturityAmount   Decimal?                @db.Decimal(14, 2)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal                 Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  familyMember         FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  transactions         Transaction[]
  parentInvestment     Investment?   @relation("InvestmentRecurrence", fields: [parentInvestmentId], references: [id], onDelete: SetNull)
  generatedInvestments Investment[]  @relation("InvestmentRecurrence")

  @@index([userId])
  @@index([userId, category])
  @@index([goalId])
  @@index([familyMemberId])
  @@index([isRecurring, nextRecurrenceDate])
  @@map("investments")
}

model ImportHistory {
  id              String   @id @default(uuid())
  userId          String
  fileName        String
  provider        String
  totalRecords    Int
  importedRecords Int
  skippedRecords  Int
  failedRecords   Int
  totalAmount     Decimal  @default(0) @db.Decimal(14, 2)
  importedBy      String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("import_history")
}

enum TicketType {
  ERROR
  SUGGESTION
  DOUBT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// A user-raised helpdesk ticket. ERROR tickets are additionally appended to a log file for
/// future developer review; DOUBT tickets are automatically answered by the AI assistant on
/// creation (aiResponse populated synchronously); SUGGESTION tickets are simply queued for admin
/// review. adminResponse/status are managed by admins via the admin ticket dashboard.
model SupportTicket {
  id            String       @id @default(uuid())
  userId        String
  type          TicketType
  subject       String
  description   String
  status        TicketStatus @default(OPEN)
  aiResponse    String?
  adminResponse String?
  /// Optional structured context for ERROR tickets (e.g. stack trace, URL, browser/app version).
  errorContext  Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("support_tickets")
}

/// A single Razorpay checkout attempt/period for a paid (PLUS/PRO) plan. `status` moves
/// CREATED -> ACTIVE once `billing.service.ts` verifies the payment signature; the user's
/// `User.planTier`/`planExpiresAt` are updated at the same time (see billing.service.ts).
model Subscription {
  id                 String             @id @default(uuid())
  userId             String
  planTier           PlanTier
  billingCycle       BillingCycle
  status             SubscriptionStatus @default(CREATED)
  amount             Decimal            @db.Decimal(10, 2)
  currency           String             @default("INR")
  razorpayOrderId    String?            @unique
  razorpayPaymentId  String?            @unique
  razorpaySignature  String?
  startDate          DateTime?
  endDate            DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Transaction {
  id                  String          @id @default(uuid())
  userId              String
  type                TransactionType
  sourceType          TransactionSourceType?
  sourceId            String?
  amount              Decimal         @db.Decimal(14, 2)
  date                DateTime
  description         String?
  category            String?
  relatedInvestmentId String?
  bankAccountId       String?
  familyMemberId      String?
  createdAt           DateTime        @default(now())

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedInvestment Investment?   @relation(fields: [relatedInvestmentId], references: [id], onDelete: SetNull)
  bankAccount       BankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  familyMember      FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, date])
  @@unique([sourceType, sourceId])
  @@map("transactions")
}

model Expense {
  id                 String              @id @default(uuid())
  userId             String
  date               DateTime
  category           ExpenseCategory
  amount             Decimal             @db.Decimal(14, 2)
  paymentMode        PaymentMode
  description        String?
  bankAccountId      String?
  isRecurring        Boolean             @default(false)
  recurrenceInterval RecurrenceInterval?
  recurrenceEndDate  DateTime?
  nextRecurrenceDate DateTime?
  paidDate           DateTime?
  snoozedUntil       DateTime?
  parentExpenseId    String?
  receiptUrl         String?
  familyMemberId     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount       BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  parentExpense     Expense?       @relation("ExpenseRecurrence", fields: [parentExpenseId], references: [id], onDelete: SetNull)
  generatedExpenses Expense[]      @relation("ExpenseRecurrence")
  splits            ExpenseSplit[]
  familyMember      FamilyMember?  @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, date])
  @@index([isRecurring, nextRecurrenceDate])
  @@index([familyMemberId])
  @@map("expenses")
}

model ExpenseSplit {
  id              String   @id @default(uuid())
  expenseId       String
  participantName String
  amount          Decimal  @db.Decimal(14, 2)
  isSettled       Boolean  @default(false)
  createdAt       DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_splits")
}

model Income {
  id                    String              @id @default(uuid())
  userId                String
  date                  DateTime
  source                IncomeSource
  amount                Decimal             @db.Decimal(14, 2)
  description           String?
  bankAccountId         String?
  isRecurring           Boolean             @default(false)
  recurrenceInterval    RecurrenceInterval?
  recurrenceEndDate     DateTime?
  nextRecurrenceDate    DateTime?
  parentIncomeId        String?
  familyMemberId        String?
  incomeSourceProfileId String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount         BankAccount?         @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  parentIncome        Income?              @relation("IncomeRecurrence", fields: [parentIncomeId], references: [id], onDelete: SetNull)
  generatedIncomes    Income[]             @relation("IncomeRecurrence")
  familyMember        FamilyMember?        @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  incomeSourceProfile IncomeSourceProfile? @relation(fields: [incomeSourceProfileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, date])
  @@index([isRecurring, nextRecurrenceDate])
  @@index([incomeSourceProfileId])
  @@map("income")
}

model BusinessEntry {
  id           String            @id @default(uuid())
  userId       String
  businessName String
  type         BusinessEntryType
  category     String?
  amount       Decimal           @db.Decimal(14, 2)
  date         DateTime
  description  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, businessName])
  @@index([userId, date])
  @@map("business_entries")
}

model BusinessProfile {
  id              String       @id @default(uuid())
  userId          String
  name            String
  legalName       String?
  type            BusinessType @default(MANUFACTURING)
  currency        String       @default("INR")
  fiscalYearStart Int          @default(4)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts       BusinessAccount[]
  journalEntries BusinessJournalEntry[]
  products       BusinessProduct[]
  suppliers      BusinessSupplier[]
  warehouses     BusinessWarehouse[]
  stockMovements BusinessStockMovement[]
  boms           BusinessBom[]
  purchaseOrders BusinessPurchaseOrder[]
  productionOrders BusinessProductionOrder[]
  customers      BusinessCustomer[]
  salesInvoices  BusinessSalesInvoice[]
  creditNotes    BusinessCreditNote[]
  quotations     BusinessQuotation[]
  salesOrders    BusinessSalesOrder[]
  salesReturns   BusinessSalesReturn[]
  members        BusinessMember[]
  periods        BusinessAccountingPeriod[]
  serviceClients BusinessServiceClient[]
  serviceProjects BusinessServiceProject[]

  @@index([userId, isActive])
  @@map("business_profiles")
}

model BusinessAccount {
  id         String              @id @default(uuid())
  businessId String
  code       String
  name       String
  type       BusinessAccountType
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  business BusinessProfile      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines    BusinessJournalLine[]

  @@unique([businessId, code])
  @@index([businessId, type])
  @@map("business_accounts")
}

model BusinessJournalEntry {
  id          String             @id @default(uuid())
  businessId  String
  entryDate   DateTime
  reference   String?
  description String
