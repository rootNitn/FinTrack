# ==== Database ====
# Note: mapped to host port 5433 (not the default 5432) to avoid clashing with any
# pre-existing local Postgres installation/service already bound to 5432.
DATABASE_URL="postgresql://finance_user:finance_password@localhost:5433/finance_tracker?schema=public"

# ==== Server ====
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# ==== JWT ====
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER_ME=30d

# ==== Password Reset ====
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h
# Optional Resend email delivery. Set both values to enable reset emails.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=nvnverma9517@gmail.com
FRONTEND_URL=http://localhost:4200

# ==== Gmail SMTP (alternative to Resend) ====
# App Password from https://myaccount.google.com/apppasswords (requires 2-Step Verification —
# NOT your normal Gmail password). If both are set, Gmail is used instead of Resend.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ==== Bank Account Encryption ====
# 32-byte (64 hex char) key used to encrypt bank account numbers at rest (AES-256-GCM)
ACCOUNT_NUMBER_ENCRYPTION_KEY=a1b2c3d4e5f60718a1b2c3d4e5f60718a1b2c3d4e5f60718a1b2c3d4e5f60718

# ==== Rate Limiting ====
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ==== Sign in with Google ====
# OAuth 2.0 Client ID (Web application) from https://console.cloud.google.com/apis/credentials.
# Must match the client ID configured in the frontend environment files. Leave blank to disable.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ==== AI Chat Assistant ====
# Free API key from https://console.groq.com/keys (Groq — OpenAI-compatible chat completions,
# no billing/project setup required). Leave blank to disable the AI chat widget (it will show a
# friendly "not configured" message instead of erroring).
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ==== Billing (Razorpay) ====
# Test/live keys from https://dashboard.razorpay.com/app/keys (Settings > API Keys) and
# Settings > Webhooks (for RAZORPAY_WEBHOOK_SECRET). Leave blank to disable Plus/Pro checkout
# (the billing endpoints return a friendly "not configured" error instead of erroring).
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
